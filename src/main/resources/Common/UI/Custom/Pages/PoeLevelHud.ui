$C = "../Common.ui";
Panel {
  Anchor: (Left: 20, Top: 20, Width: 320, Height: 54);
  Background: (Color: #00000088);
  Padding: (Left: 8, Right: 8, Top: 6, Bottom: 6);
  Children: [
    ProgressBar {
      Id: "XPBar";
      Anchor: (Left: 0, Top: 0, Width: 304, Height: 14);
      Value: 0;
    },
    Label {
      Id: "LevelLabel";
      Anchor: (Left: 0, Top: 18, Width: 304, Height: 28);
      Text: "Level 1 • 0 / 100 XP";
      FontSize: 14;
      TextColor: #ffffffff;
    }
  ];
}
